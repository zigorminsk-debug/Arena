    <!-- About -->
    <string name="about_title">About</string>
    <string name="about_message">Arena Mobile is an independent WebView shell for arena.ai: quick account switching, GitHub connection in Agent Mode and desktop mode.\n\nThe app updates itself from GitHub Releases and accepts shared text from other apps.\n\nNot affiliated with Arena. Data never leaves your device — there is no analytics or third-party SDK.</string>
